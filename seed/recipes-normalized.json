"pasos": [
{
"orden": 1,
"descripcion": "En una olla grande o cacerola profunda, calentá el aceite de oliva a fuego medio."
},
{
"orden": 2,
"descripcion": "Agregá la cebolla, las zanahorias y el apio. Cociná durante 8 a 10 minutos, revolviendo cada tanto, hasta que estén tiernos."
},
{
"orden": 3,
"descripcion": "Agregá el ajo y cociná 2 minutos más, hasta que largue aroma. Condimentá con una pizca de sal y pimienta negra."
},
{
"orden": 4,
"descripcion": "Sumá los tomates, el nabo y las lentejas rojas. Mezclá bien."
},
{
"orden": 5,
"descripcion": "Incorporá el caldo de verduras, subí el fuego y llevá la sopa a hervor. Bajá a fuego suave y cociná durante 20 minutos, hasta que el nabo esté tierno y las lentejas estén cocidas."
},
{
"orden": 6,
"descripcion": "Agregá la pechuga de pollo y el perejil. Cociná 5 minutos más y ajustá los condimentos a gusto."
},
{
"orden": 7,
"descripcion": "Serví la sopa caliente con perejil fresco y los toppings adicionales."
}
],
