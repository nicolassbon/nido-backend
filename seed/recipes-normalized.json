"pasos": [
{
"orden": 1,
"descripcion": "Calentá una sartén grande a fuego medio y cubrila con aerosol antiadherente."
},
{
"orden": 2,
"descripcion": "Agregá los huevos batidos y revolvé casi constantemente con una espátula durante 3 minutos, hasta que queden revueltos, esponjosos y cocidos."
},
{
"orden": 3,
"descripcion": "Retirá los huevos a un plato chico y limpiá la sartén."
},
{
"orden": 4,
"descripcion": "Agregá 1 cucharada de aceite de sésamo a la sartén y subí el fuego a medio-alto."
},
{
"orden": 5,
"descripcion": "Agregá las zanahorias, el zucchini, las chauchas, los hongos, el jengibre y el ajo."
},
{
"orden": 6,
"descripcion": "Salteá, revolviendo seguido, durante 5 a 7 minutos, hasta que las verduras se ablanden un poco."
},
{
"orden": 7,
"descripcion": "Agregá el arroz. La mezcla puede parecer seca, pero la idea es que el arroz se dore y quede crocante."
},
{
"orden": 8,
"descripcion": "Salteá todo durante unos 2 minutos. En un bowl chico, mezclá la salsa de soja con el azúcar rubia hasta que se disuelva."
},
{
"orden": 9,
"descripcion": "Verté la salsa en la sartén y mezclá para cubrir todo de forma pareja."
},
{
"orden": 10,
"descripcion": "Terminá con un chorrito adicional de aceite de sésamo, aproximadamente 1 cucharadita."
},
{
"orden": 11,
"descripcion": "Agregá el huevo revuelto a la sartén y mezclá bien."
},
{
"orden": 12,
"descripcion": "Serví."
}
],
