"pasos": [
{
"orden": 1,
"descripcion": "En una sartén grande a fuego medio-alto, calentá el aceite vegetal y dorá la carne."
},
{
"orden": 2,
"descripcion": "Agregá la cebolla de verdeo y el morrón. Cociná, revolviendo seguido, durante unos 5 minutos, hasta que las verduras estén blandas."
},
{
"orden": 3,
"descripcion": "Agregá el ajo y salteá 1 minuto más."
},
{
"orden": 4,
"descripcion": "Sumá el ají molido, sal y pimienta a gusto. Reservá el relleno hasta el momento de usar."
},
{
"orden": 5,
"descripcion": "Tamizá la harina, la sal y el polvo para hornear en un bowl grande o en el bowl de una procesadora."
},
{
"orden": 6,
"descripcion": "Procesá o integrá la grasa vegetal a mano hasta que la mezcla tenga textura de harina de maíz."
},
{
"orden": 7,
"descripcion": "Mezclá los huevos con la leche y agregalos de a poco a la harina. Integrá bien hasta formar una masa blanda."
},
{
"orden": 8,
"descripcion": "Dividí la masa en 16 porciones iguales. Espolvoreá una superficie limpia y seca con harina."
},
{
"orden": 9,
"descripcion": "Formá un bollo con cada porción y estirá cada uno sobre la superficie enharinada hasta lograr un círculo de aproximadamente 15 a 20 cm de diámetro."
},
{
"orden": 10,
"descripcion": "Colocá unas 2 cucharadas colmadas de relleno de carne sobre un lado de cada círculo, dejando un borde limpio."
},
{
"orden": 11,
"descripcion": "Pincelá los bordes con un poco de agua tibia. Doblá la masa sobre el relleno, uní los bordes y cerralos presionando con un tenedor. Repetí con el resto de la masa y el relleno."
},
{
"orden": 12,
"descripcion": "Calentá aceite para freír en una sartén mediana a fuego medio-alto."
},
{
"orden": 13,
"descripcion": "Cuando el aceite esté caliente, freí 1 o 2 pasteles por vez hasta que estén dorados de ambos lados, aproximadamente 3 minutos."
},
{
"orden": 14,
"descripcion": "Retiralos del fuego y escurrilos sobre papel absorbente."
},
{
"orden": 15,
"descripcion": "Servilos calientes o a temperatura ambiente."
}
],
