# PostgreSQL container settings (used by docker-compose)
POSTGRES_USER=nido
POSTGRES_PASSWORD=Your_password123
POSTGRES_DB=nido
POSTGRES_PORT=5432

# Backend connection string (used by API runtime and EF tooling)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=nido;Username=nido;Password=Your_password123

# Example when API runs inside Docker Compose (use service-name host on compose network)
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=nido;Username=nido;Password=Your_password123

# Email delivery via Resend HTTP API
# Use a verified sender domain/subdomain in production, e.g. no-reply@mail.nidoapp.online
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
Email__FromAddress=onboarding@resend.dev
Email__FromName=Nido

# Frontend base URL (usado en los links de invitación)
Frontend__BaseUrl=http://localhost:4200
# Auth settings
Jwt__Key=change-me-with-a-long-random-secret-minimum-32-characters
Google__ClientId=your-google-client-id.apps.googleusercontent.com

# DigitalOcean Spaces — image storage
# Set Enabled=true to activate S3 uploads
Spaces__Enabled=false
# Dev bucket
Spaces__Bucket=nido-dev
Spaces__PublicBaseUrl=https://nido-dev.nyc3.digitaloceanspaces.com
Spaces__Endpoint=https://nyc3.digitaloceanspaces.com
Spaces__Region=nyc3
# NEVER commit real credentials — set these in your local .env only
Spaces__AccessKey=
Spaces__SecretKey=

# Telegram Bot integration (reserved for downstream personas)
# Secret placeholders only. Operational defaults live in
# src/Nido.Api/appsettings.json under the "Telegram" section and SHOULD NOT be
# duplicated here unless you intentionally need to override them per environment.
Telegram__BotToken=
Telegram__WebhookSecretToken=
Telegram__BotUsername=
Telegram__WebhookUrl=

# Web Push VAPID Settings
Vapid__PublicKey=your-public-vapid-key
Vapid__PrivateKey=hyour-private-vapid-key
Vapid__Subject=mailto:

# VTEX integration
VTEX_SHA256_HASH=your-vtex-sha256-hash

# Mercado Pago is disabled by default for local development. To test payments,
# set Mode to Sandbox and provide intentional sandbox credentials.
MercadoPago__Mode=Disabled
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__WebhookSecret=
MercadoPago__UnitPrice=1.00
# Configure the Mercado Pago application webhook in its dashboard.
